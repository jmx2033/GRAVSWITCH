#!/usr/bin/env bash
# commit-msg 钩子：提交信息写完后、提交生成前校验格式。
# 只用 bash + grep + sed，不依赖 Python，六台 Windows 机器的 Git Bash 都能直接跑。
# 规则与 Tools/ci/checks.py 的 validate_subject 一致，详见 docs/工程规范.md §5.2。

msg_file="$1"
subject="$(head -n 1 "$msg_file" | tr -d '\r')"

case "$subject" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

fail() {
  printf '\n[commit-msg] 提交被拦截：%s\n' "$1" >&2
  printf '  本次信息：%s\n' "$subject" >&2
  printf '  正确格式：<type>(<scope>): <描述> [P编号]\n' >&2
  printf '  type  ∈ feat/fix/art/docs/chore/refactor\n' >&2
  printf '  scope ∈ charge/slash/enemy/ui/build/repo/levelup\n' >&2
  printf '  示例：feat(slash): 三段刃形按蓄力进度切换 [P1-1]\n' >&2
  printf '  说明：docs/工程规范.md §5.2；想改规则先找策划，不要用 --no-verify 绕过\n\n' >&2
  exit 1
}

types='feat|fix|art|docs|chore|refactor'
scopes='charge|slash|enemy|ui|build|repo|levelup'

printf '%s' "$subject" | grep -Eq "^($types)\(($scopes)\): .+" \
  || fail '格式不符（注意 type 与 scope 都要在表里，冒号后有一个空格）'

type="$(printf '%s' "$subject" | sed -E 's/^([a-z]+)\(.*/\1/')"
scope="$(printf '%s' "$subject" | sed -E 's/^[a-z]+\(([a-z]+)\).*/\1/')"
body="$(printf '%s' "$subject" | sed -E 's/^[a-z]+\([a-z]+\): //')"
desc="$(printf '%s' "$body" | sed -E 's/\[(P[012]-[0-9]+|P0-lite)\]//g; s/ \(#[0-9]+\)$//; s/^ +//; s/ +$//')"

[ "${#desc}" -ge 4 ] || fail '描述太短，要说清改了什么'

case "$desc" in
  update|test|wip|fix|1|修改|改了一下|最终版|更新|Update|Test|WIP)
    fail "「$desc」不算描述，要写清改了哪个功能" ;;
esac

case "$desc" in
  *。|*；|*\.|*\;) fail '描述末尾不加句号' ;;
esac

case "$type" in
  feat|fix|art)
    if [ "$scope" != "repo" ]; then
      printf '%s' "$body" | grep -Eq '\[(P[012]-[0-9]+|P0-lite)\]' \
        || fail '功能/修复/美术提交必须带 P 编号，如 [P0-3]（scope=repo 的仓库维护除外）'
    fi
    ;;
esac

exit 0
